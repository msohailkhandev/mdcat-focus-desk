{
  "name": "mdcat-focus-desk",
  "version": "0.1.0",
  "description": "A consent-first practice-test desk for MDCAT students that responds to live camera-derived composure signals (Presage SmartSpectra SDK).",
  "private": true,
  "license": "MIT",
  "author": "Abdul (Implorio)",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0",
    "dotenv": "^17.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.implorio.mdcatfocusdesk",
    "productName": "MDCAT Focus Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra/"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSCameraUsageDescription": "MDCAT Focus Desk uses the camera to measure your pulse and breathing for the practice session."
      },
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-darwin-${arch}/",
          "to": "smartspectra/"
        }
      ]
    }
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.19"
  }
}
